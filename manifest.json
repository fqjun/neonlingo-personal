{
  "manifest_version": 3,
  "name": "NeonLingo 个人版",
  "version": "1.0.0",
  "description": "沉浸式英语学习：按你的水平把中文网页中的部分词语替换为英文，划词翻译，生词本与间隔重复复习。",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_page": "options/options.html",
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "alarms"],
  "host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "120"
}
